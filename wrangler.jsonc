{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "de-log-site",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "assets": {
    "directory": ".",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  "routes": [
    {
      "pattern": "delog.log.com",
      "custom_domain": true
    }
  ]
}
